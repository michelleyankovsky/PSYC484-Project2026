import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.optimize import minimize

# CONFIG

DATA_PATH = "/Users/michelleyankovsky/Desktop/Phase2_data (1).csv"

RESPONSE_COL = "response"       # 0 = chose left, 1 = chose right
PROBL_COL = "probL"
PROBR_COL = "probR"
DELTA_SV_COL = "SPTdeltaSV"     # current-trial delta SV = risky SV - certain SV
SUBJECT_COL = "PID"
TRIAL_COL = "trial"

N_BINS = 10
X_MIN = -0.8
X_MAX = 1.3

# LOAD

df = pd.read_csv(DATA_PATH)

needed = [
    RESPONSE_COL, PROBL_COL, PROBR_COL,
    DELTA_SV_COL, SUBJECT_COL, TRIAL_COL
]
missing = [c for c in needed if c not in df.columns]
if missing:
    raise ValueError(f"Missing columns: {missing}")

for col in needed:
    df[col] = pd.to_numeric(df[col], errors="coerce")

df = df.dropna(subset=needed).copy()
df = df.sort_values([SUBJECT_COL, TRIAL_COL]).reset_index(drop=True)


# DEFINE GAMBLE SIDE AND WHETHER GAMBLE WAS CHOSEN


df["choose_left"] = (df[RESPONSE_COL] == 0).astype(int)
df["choose_right"] = (df[RESPONSE_COL] == 1).astype(int)

df["left_is_risky"] = df[PROBL_COL] < 1.0
df["right_is_risky"] = df[PROBR_COL] < 1.0

# Keep only trials with one risky and one certain option
df = df[
    (df["left_is_risky"] & ~df["right_is_risky"]) |
    (~df["left_is_risky"] & df["right_is_risky"])
].copy()

df["choose_gamble"] = np.where(
    (df["left_is_risky"] & (df["choose_left"] == 1)) |
    (df["right_is_risky"] & (df["choose_right"] == 1)),
    1, 0
).astype(int)

# Restrict plotting range
df = df[(df[DELTA_SV_COL] >= X_MIN) & (df[DELTA_SV_COL] <= X_MAX)].copy()


# ORIGINAL APT EQUATION
# P(Gamble) = 1 / (1 + exp(-mu * ΔSV))


def apt_prob(delta_sv, mu):
    return 1 / (1 + np.exp(-mu * delta_sv))


# FIT mu BY MAXIMUM LIKELIHOOD


x = df[DELTA_SV_COL].to_numpy()
y = df["choose_gamble"].to_numpy()

def neg_log_likelihood(params, x, y):
    mu = params[0]
    p = apt_prob(x, mu)
    p = np.clip(p, 1e-10, 1 - 1e-10)
    return -np.sum(y * np.log(p) + (1 - y) * np.log(1 - p))

result = minimize(
    neg_log_likelihood,
    x0=np.array([1.0]),   # initial guess for mu
    args=(x, y),
    method="L-BFGS-B",
    bounds=[(0.001, 50)]
)

if not result.success:
    raise RuntimeError(f"Optimization failed: {result.message}")

mu_hat = result.x[0]
nll = result.fun

print(f"Estimated mu = {mu_hat:.4f}")
print(f"Negative log-likelihood = {nll:.4f}")


# BINNED OBSERVED DATA


def binned_summary(subdf, x_col, y_col, bins):
    subdf = subdf.copy()
    subdf["bin"] = pd.cut(subdf[x_col], bins=bins, include_lowest=True, labels=False)

    centers = 0.5 * (bins[:-1] + bins[1:])
    means = np.full(len(centers), np.nan)
    sems = np.full(len(centers), np.nan)
    counts = np.zeros(len(centers), dtype=int)

    for b, g in subdf.groupby("bin"):
        if pd.isna(b):
            continue
        b = int(b)
        vals = g[y_col].to_numpy()
        if len(vals) == 0:
            continue

        means[b] = np.mean(vals)
        sems[b] = np.std(vals, ddof=1) / np.sqrt(len(vals)) if len(vals) > 1 else 0.0
        counts[b] = len(vals)

    return centers, means, sems, counts

bins = np.linspace(X_MIN, X_MAX, N_BINS + 1)
x_all, y_all, e_all, n_all = binned_summary(df, DELTA_SV_COL, "choose_gamble", bins)


# MODEL-PREDICTED CURVE FROM EXPLICIT APT EQUATION


x_curve = np.linspace(X_MIN, X_MAX, 400)
y_curve = apt_prob(x_curve, mu_hat)

# PLOT

plt.figure(figsize=(9, 6))

plt.errorbar(
    x_all, y_all, yerr=e_all,
    fmt="o-", color="black", linewidth=2, markersize=6, capsize=4,
    label="Observed data"
)

plt.axhline(0.5, linestyle="--", color="gray", alpha=0.7)
plt.axvline(0, linestyle="--", color="gray", alpha=0.7)

plt.xlim(X_MIN, X_MAX)
plt.ylim(-0.05, 1.05)
plt.xlabel("Difference in Subjective Value (Risky - Certain)")
plt.ylabel("P(Choose Gamble)")
plt.title("Original APT Model")
plt.legend()
plt.tight_layout()
plt.show()
